{
  "name": "lowkey",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lowkey/db generate",
    "db:migrate": "pnpm --filter @lowkey/db migrate",
    "db:seed": "pnpm --filter @lowkey/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "5.9.3"
  }
}
