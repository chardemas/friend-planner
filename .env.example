# Postgres connection string. Local Postgres, or Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543). Use the pooler on Vercel; the direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lowkey

# Public URL of the site, used in emailed links. On Vercel it falls back to the production domain automatically.
# APP_URL=https://kiki.example.com

# Email (https://resend.com). Without a key, dev prints emails to the terminal and production drops them.
# RESEND_API_KEY=re_...
# EMAIL_FROM=kiki <hello@kiki.example.com>

# Shown on /privacy as the contact address, and used as Reply-To on emails.
# CONTACT_EMAIL=you@example.com
